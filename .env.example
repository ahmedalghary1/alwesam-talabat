# ملف مثال لمتغيرات البيئة
# انسخ هذا الملف إلى .env وقم بتعديل القيم

# Django Settings
SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Docker uses PostgreSQL; production may override this with MySQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=db
DB_PORT=5432

# Email Configuration
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=Alwesam Talabat <support@example.com>

# Optional bootstrap admin (required only when running create_superuser.py)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-long-random-password
DJANGO_SUPERUSER_PHONE=01000000000
DJANGO_SUPERUSER_ADDRESS=Admin Address

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
