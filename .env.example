# ===================================
# Django Settings - Required Variables
# ===================================

# CRITICAL: Generate a strong SECRET_KEY for production
# You can generate one using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# Debug mode - MUST be False in production
DEBUG=True

# Allowed hosts - comma-separated list (no spaces)
# Example: localhost,127.0.0.1,yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

