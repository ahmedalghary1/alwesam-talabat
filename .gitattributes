# Ensure shell scripts use LF line endings
*.sh text eol=lf
entrypoint.sh text eol=lf

# Ensure Docker files use LF
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf

# Ensure Python files use LF
*.py text eol=lf

# Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
