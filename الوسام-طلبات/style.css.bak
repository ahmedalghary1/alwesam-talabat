/* ==================== AL-WESAM ELITE DESIGN SYSTEM ==================== */
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&display=swap');

/* ==================== VARIABLES ==================== */
:root {
    /* Colors - Core */
    --primary-black: #0F0F0F;
    --industrial-yellow: #FFC400;
    --industrial-yellow-hover: #FFD000;
    --white: #FFFFFF;

    /* Layout */
    --container-width: 1400px;
    --header-height: 80px;
    --radius-sm: 8px;
    --radius-md: 16px;
    --radius-lg: 24px;
    --radius-full: 9999px;

    /* Animations */
    --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    --bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
}

.theme-light {
    --bg-primary: #F8F9FA;
    --bg-secondary: #EEF2F7;
    --bg-card: rgba(255, 255, 255, 0.95);
    --bg-glass: rgba(255, 255, 255, 0.95);
    --text-primary: #0D1B2A;
    --text-secondary: #475569;
    --border-color: #CBD5E1;
    --shadow-sm: 0 4px 6px -1px rgba(15, 23, 42, 0.08);
    --shadow-lg: 0 20px 25px -5px rgba(15, 23, 42, 0.12);
    --shadow-glow: 0 0 30px rgba(255, 196, 0, 0.2);
}

.theme-dark {
    --bg-primary: #0F172A;
    --bg-secondary: #1E293B;
    --bg-card: rgba(30, 41, 59, 0.8);
    --bg-glass: rgba(15, 23, 42, 0.9);
    --text-primary: #F8FAFC;
    --text-secondary: #CBD5E1;
    --border-color: #334155;
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.6);
    --shadow-glow: 0 0 30px rgba(255, 196, 0, 0.15);
}

/* ==================== RESET & BASE ==================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    font-family: 'Cairo', 'Inter', sans-serif;
    /* Cairo priority for Arabic */
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    overflow-x: hidden;
    transition: background-color var(--transition-normal), color var(--transition-normal);
}

a {
    text-decoration: none;
    color: inherit;
    transition: var(--transition-fast);
}

ul {
    list-style: none;
}

button,
input {
    font-family: inherit;
    outline: none;
}

/* ==================== UTILITIES ==================== */
.container {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 clamp(1rem, 5vw, 2rem);
    width: 100%;
}

.glass-panel {
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-color);
}

.flex-center {
    display: flex;
    align-items: center;
    justify-content: center;
}

.flex-between {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.flex-col {
    display: flex;
    flex-direction: column;
}

.gap-05 {
    gap: 0.5rem;
}

.gap-1 {
    gap: 1rem;
}

.mb-1 {
    margin-bottom: 1rem;
}

.mb-2 {
    margin-bottom: 2rem;
}

.w-full {
    width: 100%;
}

/* RTL Support Utilities */
[dir="rtl"] .mr-2 {
    margin-right: 0;
    margin-left: 0.5rem;
}

[dir="rtl"] .ml-2 {
    margin-left: 0;
    margin-right: 0.5rem;
}

/* ==================== ANIMATIONS ==================== */
@keyframes fadeIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
}

.animate-slide-up {
    animation: slideUp 0.8s ease-out forwards;
}

.delay-100 {
    animation-delay: 0.1s;
}

.delay-200 {
    animation-delay: 0.2s;
}

.delay-300 {
    animation-delay: 0.3s;
}

/* Ripple Effect */
.ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    transform: scale(0);
    animation: ripple-animation 0.6s linear;
    pointer-events: none;
}

@keyframes ripple-animation {
    to {
        transform: scale(4);
        opacity: 0;
    }
}

/* ==================== COMPONENTS ==================== */

/* Buttons */
.btn-primary {
    position: relative;
    overflow: hidden;
    background: var(--industrial-yellow);
    color: var(--primary-black);
    padding: 0 clamp(1rem, 2vw, 1.5rem);
    border-radius: clamp(8px, 1.5vw, var(--radius-md));
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: var(--transition-fast);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    white-space: nowrap;
    flex-shrink: 0;
    box-shadow: 0 4px 15px rgba(255, 196, 0, 0.25);
    height: clamp(44px, 5.8vw, 50px);
}

.btn-primary:hover {
    background: var(--industrial-yellow-hover);
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(255, 196, 0, 0.4);
}

.btn-hero {
    padding: clamp(0.7rem, 1.2vw, 0.9rem) clamp(1.3rem, 2.5vw, 1.8rem);
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
}

.action-btn {
    width: clamp(44px, 5.8vw, 50px);
    height: clamp(44px, 5.8vw, 50px);
    border-radius: 50%;
    border: 2px solid var(--border-color);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-fast);
    font-size: clamp(1.05rem, 2.1vw, 1.25rem);
    flex-shrink: 0;
}

.action-btn:hover {
    border-color: var(--industrial-yellow);
    color: var(--industrial-yellow);
    background: rgba(255, 196, 0, 0.05);
}

/* Language Selector */
.lang-selector {
    position: relative;
    display: inline-block;
}

.lang-btn {
    width: clamp(44px, 5.8vw, 50px);
    height: clamp(44px, 5.8vw, 50px);
    border-radius: 50%;
    border: 2px solid var(--border-color);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-fast);
    font-size: clamp(1.05rem, 2.1vw, 1.25rem);
    flex-shrink: 0;
    position: relative;
}

.lang-btn:hover {
    border-color: var(--industrial-yellow);
    color: var(--industrial-yellow);
    background: rgba(255, 196, 0, 0.05);
}

.lang-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    min-width: 150px;
    z-index: 1001;
    overflow: hidden;
}

.lang-selector:hover .lang-dropdown,
.lang-selector.active .lang-dropdown {
    display: block;
    animation: slideUp 0.2s ease-out;
}

.lang-option {
    padding: clamp(0.6rem, 1vw, 0.8rem) clamp(1rem, 1.5vw, 1.2rem);
    cursor: pointer;
    transition: var(--transition-fast);
    border: none;
    background: transparent;
    width: 100%;
    text-align: right;
    font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.lang-option:hover {
    background: var(--bg-secondary);
    color: var(--industrial-yellow);
}

.lang-option.active {
    background: var(--industrial-yellow);
    color: var(--primary-black);
    font-weight: 600;
}

/* 3D Tilt Card */
.tilt-card {
    will-change: transform;
    transform-style: preserve-3d;
    transition: transform 0.1s ease-out;
    /* Super fast for mouse move */
}

.tilt-inner {
    transform: translateZ(20px);
}

/* Navbar */
.navbar {
    height: auto;
    min-height: 65px;
    background: var(--bg-glass);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: clamp(0.35rem, 0.6vw, 0.5rem) 0;
}

.nav-container {
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
    /* Prevent wrapping implies single row */
    gap: clamp(0.5rem, 1.5vw, 0.8rem);
    min-height: 65px;
}

/* Desktop Navigation Layout */
@media (min-width: 969px) {
    .nav-container {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 2rem;
        align-items: center;
    }

    .nav-left {
        grid-column: 1;
    }

    .nav-menu {
        grid-column: 2;
        width: auto;
        order: unset;
        /* Reset order */
        justify-content: center;
        margin: 0;
    }

    .nav-actions {
        grid-column: 3;
        order: unset;
        /* Reset order */
        width: auto;
        justify-content: flex-end;
    }
}

.logo {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.5vw, 0.7rem);
    font-weight: 900;
    font-size: clamp(1.15rem, 2.4vw, 1.35rem);
    white-space: nowrap;
}

.logo-icon {
    width: clamp(42px, 5.8vw, 50px);
    height: clamp(42px, 5.8vw, 50px);
    background: var(--industrial-yellow);
    border-radius: clamp(8px, 1vw, 12px);
    color: var(--primary-black);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(1.25rem, 2.4vw, 1.35rem);
    flex-shrink: 0;
}

.nav-menu {
    display: flex;
    flex-wrap: wrap;
    order: 3;
    width: 100%;
    justify-content: center;
}

/* Navbar extras */
.nav-left {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.5vw, 0.75rem);
    flex-shrink: 0;
    order: 1;
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.8vw, 1rem);
    order: 2;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.nav-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(40px, 5vw, 48px);
    height: clamp(40px, 5vw, 48px);
    border-radius: clamp(6px, 1vw, 10px);
    border: 1px solid var(--border-color);
    background: transparent;
    flex-shrink: 0;
    font-size: clamp(1rem, 2vw, 1.25rem);
}

.nav-title {
    font-weight: 700;
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    white-space: nowrap;
}

/* Mobile nav list spacing */
@media (max-width: 968px) {
    .nav-menu li {
        margin-bottom: 1rem;
    }

    .btn-login {
        display: inline-flex;
    }
}

.nav-link {
    font-weight: 600;
    color: var(--text-secondary);
    position: relative;
    padding: 0.5rem clamp(0.25rem, 1vw, 0.5rem);
    font-size: clamp(0.8rem, 1.2vw, 1rem);
    white-space: nowrap;
}

.nav-link:hover,
.nav-link.active {
    color: var(--text-primary);
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--industrial-yellow);
    transition: 0.3s;
}

.nav-link:hover::after,
.nav-link.active::after {
    width: 100%;
}

/* Hero Section */
.hero-section {
    position: relative;
    min-height: 85vh;
    /* Taller hero */
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    /* Background Image Implementation */
    background-image: url('./cart-bg.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
}

/* Overlay to ensure text readability on image */
.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    background: linear-gradient(135deg, rgba(15, 15, 15, 0.6) 0%, rgba(15, 15, 15, 0.4) 100%);
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
}

.hero-title {
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.1;
    font-weight: 900;
    margin-bottom: 1.5rem;
    color: var(--white);
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.5);
}

.hero-text {
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2.5rem;
}

/* Cards Grid */
.card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    padding: 3rem 0;
}

.modern-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.2rem;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(10px);
    transition: transform 0.3s, box-shadow 0.3s;
}

.modern-card:hover {
    border-color: var(--industrial-yellow);
    box-shadow: var(--shadow-glow);
    transform: translateY(-5px);
}

.card-icon {
    width: 85px;
    height: 85px;
    background: var(--bg-primary);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    color: var(--industrial-yellow);
    margin-bottom: 1.5rem;
    transition: 0.4s;
    box-shadow: 0 4px 12px rgba(255, 196, 0, 0.1);
}

.modern-card:hover .card-icon {
    background: var(--industrial-yellow);
    color: var(--primary-black);
    transform: rotate(10deg) scale(1.15);
    box-shadow: 0 6px 20px rgba(255, 196, 0, 0.3);
}

/* Product Specifics */
.product-card {
    background: var(--bg-card);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-color);
    transition: var(--transition-normal);
}

.product-image-wrapper {
    position: relative;
    background: var(--white);
    /* White background for product images usually looks best */
    padding: 2rem;
    display: flex;
    justify-content: center;
}

.product-image {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    transition: transform 0.3s;
}

.product-card:hover .product-image {
    transform: scale(1.05);
}

/* Footer */
.footer {
    background: var(--bg-secondary);
    padding: 5rem 1rem 2rem;
    border-top: 1px solid var(--border-color);
}

/* Mobile & Responsive */
.mobile-toggle {
    display: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--text-primary);
}

/* Mobile & Responsive - Tablet and smaller */
@media (max-width: 1024px) {
    .btn-primary {
        padding: clamp(0.5rem, 1vw, 0.7rem) clamp(0.85rem, 2vw, 1.4rem);
        font-size: clamp(0.8rem, 1.2vw, 0.9rem);
    }

    .btn-hero {
        padding: clamp(0.65rem, 1.2vw, 0.85rem) clamp(1.2rem, 2.5vw, 1.6rem);
        font-size: clamp(0.9rem, 1.3vw, 1rem);
    }

    .action-btn {
        width: clamp(42px, 5.4vw, 46px);
        height: clamp(42px, 5.4vw, 46px);
        font-size: clamp(0.95rem, 1.9vw, 1.1rem);
    }

    .badge-counter {
        font-size: clamp(0.65rem, 1.1vw, 0.8rem);
    }
}

@media (max-width: 768px) {
    .navbar {
        padding: clamp(0.3rem, 0.6vw, 0.5rem) 0;
        min-height: 60px;
    }

    .nav-container {
        gap: clamp(0.4rem, 1.3vw, 0.8rem);
        min-height: 60px;
    }

    .nav-menu {
        display: none;
        position: fixed;
        top: 60px;
        right: 0;
        width: 100%;
        max-height: calc(100vh - 60px);
        background: var(--bg-primary);
        flex-direction: column;
        padding: 0.8rem 1.3rem;
        z-index: 999;
        border-top: 1px solid var(--border-color);
        gap: 0.2rem;
        overflow-y: auto;
    }

    [dir="ltr"] .nav-menu {
        left: 0;
        right: auto;
    }

    .nav-menu.active {
        display: flex;
        animation: slideUp 0.3s ease-out;
    }

    .nav-menu li {
        margin-bottom: 0.6rem;
    }

    .nav-link {
        padding: 0.4rem 0;
        font-size: clamp(0.85rem, 2.1vw, 0.95rem);
    }

    .mobile-toggle {
        display: flex;
        font-size: clamp(1.3rem, 2.2vw, 1.6rem);
        cursor: pointer;
        color: var(--text-primary);
    }

    /* Mobile Navbar Fixes */
    .nav-actions {
        gap: clamp(0.3rem, 0.9vw, 0.6rem);
        flex-wrap: nowrap;
    }

    .btn-login {
        display: inline-flex;
        padding: 0 0.5rem;
        /* Reduced padding */
        height: 34px;
        /* Fixed small height */
        font-size: 0.75rem;
        border-radius: 6px;
        align-items: center;
    }

    .btn-login span {
        display: none;
    }

    .btn-login i {
        margin: 0 !important;
        font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    }

    .btn-primary {
        padding: clamp(0.45rem, 1.1vw, 0.6rem) clamp(0.8rem, 1.9vw, 1rem);
        font-size: clamp(0.75rem, 1.4vw, 0.9rem);
        border-radius: clamp(6px, 1vw, 8px);
    }

    .btn-primary span {
        display: none;
    }

    .btn-primary i {
        margin: 0 !important;
        font-size: clamp(1rem, 2vw, 1.2rem);
    }

    .badge-counter {
        position: absolute;
        top: -8px;
        right: -8px;
        width: clamp(20px, 3.6vw, 26px);
        height: clamp(20px, 3.6vw, 26px);
        font-size: clamp(0.6rem, 1.2vw, 0.75rem);
    }

    .action-btn {
        width: clamp(38px, 4.5vw, 44px);
        height: clamp(38px, 4.5vw, 44px);
        font-size: clamp(0.85rem, 1.6vw, 1rem);
    }

    .container {
        padding: 0 clamp(0.75rem, 2vw, 1rem);
    }

    .nav-back {
        width: clamp(40px, 5vw, 48px);
        height: clamp(40px, 5vw, 48px);
        font-size: clamp(1rem, 2vw, 1.25rem);
    }

    .nav-title {
        font-size: clamp(0.8rem, 1.7vw, 0.95rem);
    }

    .hero-content {
        padding: 1.5rem;
    }

    .btn-hero {
        padding: clamp(0.6rem, 1.1vw, 0.75rem) clamp(1rem, 2.2vw, 1.4rem);
        font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    }

    .logo {
        font-size: clamp(1.05rem, 2.2vw, 1.2rem);
        gap: clamp(0.35rem, 1.3vw, 0.6rem);
    }

    .logo-icon {
        width: clamp(40px, 5.2vw, 46px);
        height: clamp(40px, 5.2vw, 46px);
        font-size: clamp(1.05rem, 2.1vw, 1.15rem);
    }
}

@media (max-width: 480px) {
    .navbar {
        padding: 0.3rem 0;
        min-height: 56px;
    }

    .nav-container {
        gap: 0.2rem;
        min-height: 56px;
    }

    .logo {
        font-size: clamp(0.95rem, 2vw, 1.1rem);
        gap: 0.25rem;
    }

    .logo-icon {
        width: clamp(34px, 4.5vw, 40px);
        height: clamp(34px, 4.5vw, 40px);
        font-size: clamp(0.9rem, 1.8vw, 1rem);
    }

    .nav-actions {
        gap: 0.6rem;
    }

    .action-btn {
        width: clamp(36px, 4.2vw, 40px);
        height: clamp(36px, 4.2vw, 40px);
        font-size: clamp(0.9rem, 1.8vw, 1rem);
    }

    .btn-primary {
        padding: clamp(0.4rem, 1vw, 0.6rem) clamp(0.75rem, 1.8vw, 0.95rem);
        font-size: clamp(0.75rem, 1.4vw, 0.85rem);
    }

    .btn-primary i {
        font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    }

    .btn-hero {
        width: 100%;
        padding: clamp(0.6rem, 1.3vw, 0.75rem) clamp(1rem, 2.5vw, 1.3rem);
        font-size: clamp(0.85rem, 1.3vw, 0.95rem);
        display: block;
        text-align: center;
    }

    .nav-back {
        width: clamp(34px, 4.2vw, 40px);
        height: clamp(34px, 4.2vw, 40px);
        font-size: clamp(0.9rem, 1.8vw, 1rem);
    }

    .nav-left {
        gap: clamp(0.25rem, 0.6vw, 0.4rem);
    }

    .mobile-toggle {
        display: flex;
    }

    .btn-login {
        display: inline-flex;
        padding: 0 0.4rem;
        height: 32px;
        font-size: 0.7rem;
        border-radius: 5px;
    }

    .btn-login span {
        display: none;
    }

    .btn-login i {
        margin: 0 !important;
        font-size: clamp(0.85rem, 1.5vw, 0.95rem);
    }

    .hero-content {
        padding: 1rem;
        gap: 1rem;
    }

    .card-grid {
        grid-template-columns: 1fr;
    }

    .nav-menu {
        top: 60px;
        max-height: calc(100vh - 60px);
        padding: 0.7rem 1rem;
    }

    /* Mobile Login Button Visibility */
    .btn-login {
        display: flex !important;
        align-items: center;
        justify-content: center;
        height: clamp(38px, 4.5vw, 44px);
        /* Slightly smaller than icon buttons on mobile to fit */
        padding: 0 1rem;
    }

    /* Ensure icons match button height on mobile */
    .action-btn,
    .lang-btn {
        width: clamp(38px, 4.5vw, 44px);
        height: clamp(38px, 4.5vw, 44px);
    }

    /* Ensure primary buttons match height on mobile */
    .btn-primary {
        height: clamp(38px, 4.5vw, 44px);
        padding: 0 0.8rem;
    }
}


/* ==================== UTILITY CLASSES ADDED FOR CLEAN HTML ==================== */
.relative {
    position: relative;
}

.pt-1 {
    padding-top: 1rem;
}

.mt-auto {
    margin-top: auto;
}

.mx-auto {
    margin-left: auto;
    margin-right: auto;
}

.text-center {
    text-align: center;
}

.font-bold {
    font-weight: 700;
}

.text-lg {
    font-size: 1.25rem;
}

.section-padding {
    padding-top: 4rem;
    padding-bottom: 4rem;
}

.badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 196, 0, 0.1);
    border: 1px solid rgba(255, 196, 0, 0.2);
    color: var(--industrial-yellow);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 2rem;
}

.text-highlight {
    color: var(--industrial-yellow);
}

/* Filter Bar */
.filter-bar {
    padding: 1.5rem 0;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
}

.filter-chip {
    display: inline-flex;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    color: var(--text-primary);
    margin-left: 0.5rem;
    /* RTL margin */
    cursor: pointer;
    transition: var(--transition-fast);
    font-weight: 500;
}

.filter-chip.active,
.filter-chip:hover {
    background: var(--industrial-yellow);
    color: var(--primary-black);
    border-color: var(--industrial-yellow);
}

.no-scrollbar::-webkit-scrollbar {
    display: none;
}

.no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
}

/* Product Internals */
.product-badge-new {
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--industrial-yellow);
    color: var(--primary-black);
    padding: 4px 8px;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 4px;
    z-index: 10;
}

.product-details {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
}

.product-sku {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.25rem;
}

.product-title {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
    color: var(--text-primary);
}

.product-price {
    font-weight: 600;
    color: var(--industrial-yellow);
}

.btn-add {
    background: var(--primary-black);
    color: var(--industrial-yellow);
    border: none;
}

.badge-counter {
    background: var(--primary-black);
    color: var(--industrial-yellow);
    padding: 0.1rem 0.4rem;
    border-radius: 50%;
    font-size: 0.75rem;
    margin-right: 0.5rem;
}

/* Floating Button */
.floating-btn {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    /* RTL left */
    background: var(--industrial-yellow);
    color: var(--primary-black);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 4px 20px rgba(255, 196, 0, 0.4);
    z-index: 100;
}

/* Login Specifics */
.login-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3vw, 2rem);
    background: radial-gradient(circle at center, rgba(255, 196, 0, 0.08), transparent);
    position: relative;
    overflow: hidden;
}

.login-page::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 196, 0, 0.05), transparent);
    animation: float 6s ease-in-out infinite;
}

@keyframes float {

    0%,
    100% {
        transform: translateY(0px) rotate(0deg);
    }

    50% {
        transform: translateY(-20px) rotate(5deg);
    }
}

.login-card {
    width: 100%;
    max-width: 450px;
    padding: 3rem 2.5rem;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.85);
    /* Lighter, cleaner look */
    backdrop-filter: blur(20px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    position: relative;
    z-index: 1;
    animation: slideUp 0.6s ease-out;
}

/* Dark mode specific for login card */
.theme-dark .login-card {
    background: rgba(30, 41, 59, 0.85);
    border-color: rgba(255, 255, 255, 0.1);
}

.input-group {
    margin-bottom: clamp(1.2rem, 2vw, 1.8rem);
}

.input-label {
    display: block;
    margin-bottom: 0.6rem;
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    color: var(--text-secondary);
    font-weight: 600;
    letter-spacing: 0.5px;
}

.form-input {
    width: 100%;
    padding: clamp(0.65rem, 1.2vw, 0.9rem) clamp(0.9rem, 1.5vw, 1.2rem);
    border-radius: var(--radius-md);
    border: 2px solid var(--border-color);
    background: var(--bg-primary);
    color: var(--text-primary);
    transition: var(--transition-fast);
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    font-family: inherit;
}

.form-input:focus {
    outline: none;
    border-color: var(--industrial-yellow);
    background: var(--bg-primary);
    box-shadow: 0 0 0 4px rgba(255, 196, 0, 0.15);
    transform: translateY(-1px);
}

.form-input::placeholder {
    color: var(--text-secondary);
    opacity: 0.7;
}

.cursor-pointer {
    cursor: pointer;
}

.underline {
    text-decoration: underline;
}

.justify-center {
    justify-content: center;
}

.accent-yellow {
    accent-color: var(--industrial-yellow);
}

.icon-lg {
    width: clamp(50px, 10vw, 70px);
    height: clamp(50px, 10vw, 70px);
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--industrial-yellow), rgba(255, 196, 0, 0.8));
    border-radius: 50%;
    color: var(--primary-black);
    box-shadow: 0 8px 20px rgba(255, 196, 0, 0.25);
}



.text-xl {
    font-size: 1.75rem;
    font-weight: 800;
}

.text-sm {
    font-size: 0.875rem;
}

.mb-05 {
    margin-bottom: 0.5rem;
}

.pb-6 {
    padding-bottom: 6rem;
}

.items-end {
    align-items: flex-end;
}

/* Admin Specifics */
.admin-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 100vh;
}

.sidebar {
    background: var(--bg-card);
    border-left: 1px solid var(--border-color);
    /* RTL border */
    padding: 2rem 1rem;
    position: sticky;
    top: 0;
    height: 100vh;
}

@media (max-width: 768px) {
    .admin-layout {
        grid-template-columns: 1fr;
    }

    .sidebar {
        display: none;
    }
}

.stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
}

.dashboard-link {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: rgba(255, 196, 0, 0.1);
    color: var(--industrial-yellow);
    display: block;
}

.dashboard-link-inactive {
    padding: 0.75rem 1rem;
    display: block;
    color: var(--text-secondary);
}

.dashboard-link-inactive:hover {
    background: var(--bg-secondary);
    color: var(--text-primary);
}

.animate-spin-slow {
    animation: spin 8s linear infinite;
}

@keyframes spin {
    100% {
        transform: rotate(360deg);
    }
}

.pl-1 {
    padding-left: 1rem;
}

.items-stretch {
    align-items: stretch;
}

.avatar-sm {
    width: 40px;
    height: 40px;
    border-radius: 50%;
}

.pt-0 {
    padding-top: 0;
}

.m-0 {
    margin: 0;
}

.icon-md {
    width: 48px;
    height: 48px;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.empty-state {
    background: var(--bg-secondary);
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
    color: var(--text-secondary);
}

.icon-xs {
    width: 24px;
    height: 24px;
    font-size: 0.75rem;
}

.floating-count {
    position: absolute;
    top: -5px;
    right: -5px;
    background: var(--primary-black);
    color: var(--industrial-yellow);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
}

.footer-title {
    font-weight: 700;
    margin-bottom: 1.5rem;
}

.footer-links li {
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
}

.footer-links a:hover {
    color: var(--industrial-yellow);
}

.footer-copyright {
    text-align: center;
    padding-top: 3rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
}

.social-links {
    display: flex;
    gap: 1rem;
}

/* Additional Utilities for Product & Cart */
.grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
}

.rounded-md {
    border-radius: var(--radius-md);
}

.rounded-sm {
    border-radius: var(--radius-sm);
}

.p-2 {
    padding: 2rem;
}

.mb-05 {
    margin-bottom: 0.5rem;
}

.border-none {
    border: none !important;
}

.stock-badge {
    display: inline-block;
    background: rgba(255, 196, 0, 0.1);
    color: var(--industrial-yellow);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.75rem;
}

.page-title {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    line-height: 1.2;
}

.sku-text {
    color: var(--text-secondary);
    font-size: 1.125rem;
}

.spec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
}

.quantity-selector {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-card);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
}

.qty-val {
    font-weight: 700;
    font-size: 1.25rem;
    min-width: 2rem;
    text-align: center;
}

.flex-1 {
    flex: 1;
}

.icon-sm {
    width: 32px;
    height: 32px;
}

/* Cart Specifics */
.cart-item {
    padding: 1rem;
    border-radius: var(--radius-md);
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
}

.cart-img {
    width: 80px;
    height: 80px;
    border-radius: 8px;
    object-fit: contain;
}

.text-red {
    color: #ff4444;
}

.qty-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-primary);
    padding: 0.25rem;
    border-radius: 8px;
}

.checkout-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    padding: 1rem 0 2rem;
    border-top: 1px solid var(--border-color);
    z-index: 100;
}